# Usage: להעתיק את הקובץ הזה ל-.env ולמלא ערכים. אין לשים כאן ערכים אמיתיים.

# Provider: gemini או openai — קובע גם את ה-LLM וגם את ה-Embeddings
LLM_PROVIDER=gemini

# Gemini: מפתח מ-Google AI Studio
GOOGLE_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2

# OpenAI: נדרש רק אם LLM_PROVIDER=openai (לבדוק שמות מודלים עדכניים לפני המעבר)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
