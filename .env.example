# Usage: להעתיק את הקובץ הזה ל-.env ולמלא ערכים. אין לשים כאן ערכים אמיתיים.

# Provider: openai (ברירת מחדל) או gemini — קובע גם את ה-LLM וגם את ה-Embeddings.
# Note: החלפת ספק = מודל Embeddings אחר → python -m src.indexer --rebuild
MODEL_PROVIDER=openai

# OpenAI: מפתח בתשלום מ-platform.openai.com
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Gemini: מפתח חינמי מ-Google AI Studio (נדרש ל-MODEL_PROVIDER=gemini, ולשופט בהערכה)
GOOGLE_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
# Judge: מודל ששופט תשובות בהערכה (שלב 7) — חייב להיות שונה ממודל התשובות
GEMINI_JUDGE_MODEL=gemini-3.5-flash
