# Usage: להעתיק את הקובץ הזה ל-.env ולמלא ערכים. אין לשים כאן ערכים אמיתיים.

# Gemini: מפתח חינמי מ-Google AI Studio
GOOGLE_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
# Judge: מודל ששופט תשובות בהערכה (שלב 7) — חייב להיות שונה מ-GEMINI_LLM_MODEL
GEMINI_JUDGE_MODEL=gemini-3.5-flash
